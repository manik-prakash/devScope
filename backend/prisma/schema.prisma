// DevScope Prisma Schema
// Database: PostgreSQL 16
// Generator: @prisma/client (Node.js)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// Keep the string values in sync with frontend/lib/types.ts
// (UserRole, Plan, EvaluationStatus).
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  DEVELOPER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum EvaluationStatus {
  PENDING
  SCORED
  FAILED
  SKIPPED // used when signatureValid = false
}

enum EvaluationConfidence {
  HIGH
  MEDIUM
  LOW
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  seats     Int      @default(5)
  /// The ADMIN user who registered this org. Nullable so the user/org rows can be inserted in either order during signup; populated in the same transaction.
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
  apiKeys  ApiKey[]
  sessions Session[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  orgId          String
  email          String
  passwordHash   String
  name           String
  role           UserRole @default(DEVELOPER)
  /// Force a password change on next login. Set true when an admin/manager invites a user with a temp password.
  mustChangePass Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]
  apiKeys        ApiKey[]
  sessions       Session[]
  refreshTokens  RefreshToken[]

  @@unique([orgId, email])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Project
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  sessions Session[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────────
// ProjectMember
// ─────────────────────────────────────────────────────────────────────────────

model ProjectMember {
  projectId String
  userId    String
  role      UserRole @default(DEVELOPER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// ApiKey
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  orgId         String
  /// SHA-256 hex digest of the raw bearer token — never store the raw key
  keyHash       String    @unique
  /// HMAC signing secret returned to the CLI on GET /api/v1/me
  signingSecret String
  label         String    @default("Default")
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@index([orgId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Session
// id = session_id sent by the CLI (UUID generated by the CLI)
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  /// Primary key is the CLI-generated session UUID
  id               String           @id
  userId           String
  orgId            String
  projectId        String
  apiKeyId         String
  agent            String
  agentVersion     String
  startedAt        DateTime
  endedAt          DateTime
  durationMs       BigInt
  cliVersion       String

  /// Fully redacted sanitized message log (array of SanitizedMessage)
  messages         Json             @default("[]")

  /// Flattened behavioral stats extracted by the CLI
  stats            Json             @default("{}")

  /// Whether the CLI-supplied HMAC signature was valid
  signatureValid   Boolean          @default(false)

  /// AI evaluation fields
  evaluationStatus EvaluationStatus @default(PENDING)
  score            Float?
  /// Structured feedback object from OpenRouter
  feedback         Json?
  evaluatedAt      DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey  ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  /// Detailed multi-stage evaluation. Nullable for sessions evaluated under the
  /// legacy single-LLM evaluator, or sessions with signatureValid=false.
  scoreDetail SessionScore?

  @@index([userId])
  @@index([orgId])
  @@index([projectId])
  @@index([evaluationStatus])
  @@index([createdAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SessionScore
// Output of the multi-stage evaluation pipeline. One row per scored session.
// ─────────────────────────────────────────────────────────────────────────────

model SessionScore {
  id        String @id @default(cuid())
  sessionId String @unique
  /// Denormalized for fast historical-session lookups in the trend stage.
  userId    String
  /// Denormalized for org-scope queries.
  orgId     String

  promptQuality       Int   // 0-100, from Stage 3
  iterationEfficiency Int   // 0-100, from Stage 3
  toolUtilization     Int   // 0-100, from Stage 3
  /// Anomaly-adjusted overall score (1 decimal place, floor 5).
  overallScore        Float
  confidence          EvaluationConfidence

  summary          String  @db.Text
  strength         String  @db.Text
  improvementFocus String  @db.Text
  trendObservation String? @db.Text
  anomalyNotes     String? @db.Text

  /// Anomaly[] from Stage 2 — array of { code, severity, detail }.
  anomalies      Json @default("[]")
  /// ClassificationResult from Stage 1 — { task_type, complexity, pattern, reasoning }.
  classification Json
  /// TrendData from Stage 4 — kept for debugging / future UI surfaces.
  trends         Json?

  /// True only when ALL three LLM stages failed and the pipeline ran on fallbacks.
  evaluationFailed Boolean @default(false)
  failureReason    String?
  modelUsed        String

  evaluatedAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, evaluatedAt])
  @@index([orgId])
  @@map("session_scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// RefreshToken
// Stored server-side so tokens can be explicitly revoked (e.g. logout).
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw opaque token
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// `tokenHash` of the token this one was rotated into. Set only on rotation
  /// (null for logout / change-password bulk revocation). Lets `/auth/refresh`
  /// tell a concurrent multi-tab rotation from a genuine replay: a spent token
  /// is benign only if its own successor is still live.
  replacedByTokenHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
