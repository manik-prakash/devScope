# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://devscope:devscope@localhost:5432/devscope?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be a long, random secret (at least 64 chars recommended)
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token lifetime (ms/s/m/h format accepted by jsonwebtoken)
JWT_EXPIRES_IN="15m"
# Refresh token lifetime
REFRESH_EXPIRES_IN="7d"

# ─── OpenRouter AI Evaluation ────────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Model used for session scoring (cost-efficient default)
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (dashboard frontend)
CORS_ORIGINS="http://localhost:5173"
